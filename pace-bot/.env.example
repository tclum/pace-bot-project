# Server
PORT=3000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:8080

# Anthropic
ANTHROPIC_API_KEY=placeholder
ANTHROPIC_MODEL=claude-opus-4-7

# Voyage
VOYAGE_API_KEY=placeholder
VOYAGE_MODEL=voyage-3

# Postgres
DATABASE_URL=postgresql://user:pass@localhost:5432/liveavatar

# LiveKit (for /api/livekit-token — reuse the same values as pace-agent/.env)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
